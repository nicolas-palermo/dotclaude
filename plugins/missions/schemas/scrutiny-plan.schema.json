{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missions/scrutiny-plan.schema.json",
  "title": "Scrutiny fan-out plan (missions-specific; Factory has no plan.json because droid validators spawn their own reviewers — ours cannot, so the validator plans and the orchestrator fans out)",
  "type": "object",
  "required": ["milestone", "round", "features", "validatorsRun"],
  "properties": {
    "milestone": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["featureId"],
        "properties": {
          "featureId": { "type": "string" },
          "commitId": { "type": "string" },
          "reviewFocus": { "type": "string" },
          "addressesFailureFrom": { "type": "string" }
        }
      }
    },
    "validatorsRun": { "$ref": "#/$defs/validatorsRun" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "validatorsRun": {
      "type": "object",
      "required": ["test", "typecheck", "lint"],
      "additionalProperties": {
        "type": "object",
        "required": ["passed", "command", "exitCode"],
        "properties": {
          "passed": { "type": "boolean" },
          "command": { "type": "string" },
          "exitCode": { "type": "integer" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
